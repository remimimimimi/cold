r←LOAD root;file;src

src←⊂':Namespace cold'

src,←⊃⎕NGET(root,'/lnk/LNK.apl')1

src,←⊂':Namespace basic'
src,←⊂'⎕PATH←''↑'''
file←root,'/tests/B.apl'
:If ⎕NEXISTS file
    src,←⊃⎕NGET file 1
:EndIf
src,←⊂':EndNamespace'

src,←⊂':Namespace integration'
src,←⊂'⎕PATH←''↑'''
file←root,'/tests/I.apl'
:If ⎕NEXISTS file
    src,←⊃⎕NGET file 1
:EndIf
src,←⊂':EndNamespace'

src,←⊂':EndNamespace'

r←⎕FIX src
